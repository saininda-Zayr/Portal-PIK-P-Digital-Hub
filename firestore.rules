rules_version = '2';
// Rules Version: 2026-05-13 v1.2 - Force update
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Helpers
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "saininda@gmail.com") ||
        (request.auth.uid == "lUGYop8JDvcT2SJxjiEzBC8PD2p2") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (
        isSignedIn() && (
          (request.auth.token.email == "saininda@gmail.com") ||
          (request.auth.uid == "lUGYop8JDvcT2SJxjiEzBC8PD2p2") ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin'])
        )
      );
    }

    function isAuthorized() {
      // Direct pass for admins or authorized users
      return isSignedIn() && (
        (request.auth.token.email == "saininda@gmail.com") ||
        (request.auth.uid == "lUGYop8JDvcT2SJxjiEzBC8PD2p2") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['super_admin', 'admin'] || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'authorized'))
      );
    }

    function isWriter() {
      return isAuthorized() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'viewer'
      );
    }

    // ===============================================================
    // Collection match blocks
    // ===============================================================

    // --- Users ---
    function isValidUser(data) {
      let requiredFields = ['displayName', 'email', 'lastLogin', 'role', 'status', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredFields) &&
             data.displayName is string && data.displayName.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['super_admin', 'admin', 'staff', 'viewer'] &&
             data.status in ['authorized', 'pending'] &&
             (data.createdAt is string || data.createdAt is timestamp) &&
             (data.updatedAt is string || data.updatedAt is timestamp) &&
             // Ensure size is correct (7 required + optional photoURL)
             (data.keys().size() >= 7 && data.keys().size() <= 10); 
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isSuperAdmin() || isAuthorized()); 
      
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    // --- Stats ---
    function isValidStat(data) {
      return data.keys().hasAll(['label', 'value', 'icon', 'color', 'order']) &&
             data.label is string && data.label.size() <= 100 &&
             data.value is string && data.value.size() <= 100;
    }

    match /stats/{statId} {
      allow list, get: if isAuthorized();
      allow create, update: if isAdmin() && isValidStat(incoming());
      allow delete: if isAdmin();
    }

    // --- Requests ---
    function isValidRequest(data) {
      return data.keys().hasAll(['requesterName', 'unit', 'dataType', 'reason', 'status', 'createdAt']) &&
             data.requesterName is string && data.requesterName.size() <= 500 &&
             data.status in ['pending', 'processing', 'completed'];
    }

    match /requests/{requestId} {
      allow list: if isAuthorized();
      allow get: if isValidId(requestId) && (isAuthorized() || (isSignedIn() && existing().uid == request.auth.uid));
      
      allow create: if isValidId(requestId) && isValidRequest(incoming());
      
      allow update: if isAuthorized() && isValidId(requestId) && isValidRequest(incoming());
      allow delete: if isAdmin() && isValidId(requestId);
    }

    // --- Documents ---
    function isValidDocument(data) {
      return data.keys().hasAll(['name', 'category', 'createdAt']) &&
             data.name is string && data.name.size() <= 1000 &&
             data.category is string && data.category.size() <= 200;
    }

    match /documents/{docId} {
      allow list, get: if isAuthorized();
      allow create: if isWriter() && isValidDocument(incoming()) && 
                       incoming().uploadedBy == request.auth.uid;
      allow update: if (isAdmin() || (isWriter() && existing().uploadedBy == request.auth.uid)) && 
                       isValidDocument(incoming()) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // --- Archives ---
    function isValidArchive(data) {
      return data.keys().hasAll(['name', 'category', 'createdAt']) &&
             data.name is string && data.name.size() <= 1000;
    }

    match /archives/{archiveId} {
      allow list, get: if isAuthorized();
      allow create: if isWriter() && isValidArchive(incoming());
      allow update: if isAdmin() && isValidArchive(incoming());
      allow delete: if isAdmin();
    }

    // --- Tasks ---
    function isValidTask(data) {
      return data.keys().hasAll(['status', 'priority', 'createdAt']) &&
             (data.task is string || data.title is string);
    }

    match /tasks/{taskId} {
      allow list, get: if isAuthorized();
      allow create, update: if isWriter() && isValidTask(incoming());
      allow delete: if isAdmin();
    }

    // --- Events ---
    match /events/{eventId} {
      allow list, get: if isAuthorized();
      allow write: if isAdmin();
    }

    // --- Announcements ---
    match /announcements/{announcementId} {
      allow list, get: if isAuthorized();
      allow write: if isAdmin();
    }

    // --- SPK PPPK Submissions ---
    function isValidSpkSubmission(data) {
      return data.keys().hasAll(['nip', 'nama', 'opd', 'unitKerja', 'fileName', 'fileSize', 'uploadedAt']) &&
             data.nip is string && data.nip.size() <= 60 &&
             data.nama is string && data.nama.size() <= 250 &&
             data.opd is string && data.opd.size() <= 250 &&
             data.unitKerja is string && data.unitKerja.size() <= 250 &&
             data.fileName is string && data.fileName.size() <= 500 &&
             data.fileSize is number && data.fileSize <= 1048576; // Under 1 MB
    }

    match /spk_pppk_submissions/{submissionId} {
      allow list, get: if isAuthorized();
      allow create: if isValidSpkSubmission(incoming());
      allow update, delete: if isAdmin();
    }

    // --- System Settings (e.g. spk_drive_config) ---
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
